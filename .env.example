
# Hugging Face access token to download Qwen2.5 model weights
HF_TOKEN=

# Kaggle API credentials (only needed if a dataset is pulled via the Kaggle API)
KAGGLE_USERNAME=
KAGGLE_KEY=

# Sending mailbox for OTP emails (use a dedicated project mailbox, not personal)
OTP_EMAIL_ADDRESS=

# Gmail App Password for SMTP send (NOT your real account password)
OTP_EMAIL_APP_PASSWORD=

# Signing key for session tokens
JWT_SECRET_KEY=

# Default admin login seeded on first run
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Auth token to expose the app via ngrok (if used instead of Cloudflare Tunnel)
NGROK_AUTH_TOKEN=
